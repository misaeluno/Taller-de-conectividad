var checkbox=document.getElementById("toggle");var amount="";var duration="monthly";var actualPrices=[];var multipliedPrices=[];var discountedPrices=[];if(checkbox){checkbox.addEventListener("change",function(){if(!this.checked){ChangeToMonthly();duration="monthly";document.getElementById("discounttext").innerText=""}else{ChangeToYearly();duration="yearly";document.getElementById("discounttext").innerText='"Early Adoption Edition" For Bonus 2 More Months'}})}function ChangeToYearly(){var wholeElements=document.querySelectorAll(".whole");var centElements=document.querySelectorAll(".cent");var disc=document.getElementById("disc");var discountinYear=parseFloat(disc.value).toFixed(2);wholeElements.forEach(function(element,index){var wholeValue=parseInt(element.textContent.replace("$",""),10);var centValue=parseInt(centElements[index].textContent.replace(".",""),10);var actualPrice=wholeValue+centValue/100;var multipliedPrice=wholeValue*12+centValue*12/100;var discountedPrice=multipliedPrice*(1-discountinYear/100);actualPrices.push(actualPrice.toFixed(2));multipliedPrices.push(multipliedPrice.toFixed(2));discountedPrices.push(discountedPrice.toFixed(2));document.getElementById("discountedActualPrice"+(index+1)).textContent="$"+Math.floor(discountedPrice);document.getElementById("discountedPerPrice"+(index+1)).textContent=". "+(discountedPrice%1*100).toFixed(0).padStart(2,"0");var Actual=document.querySelectorAll(".whole");Actual.forEach(function(element){element.style.display="none"});var dec=document.querySelectorAll(".cent");dec.forEach(function(element){element.style.display="none"});var discount=document.querySelectorAll(".discounted");discount.forEach(function(element){element.style.display="block"});var discount=document.querySelectorAll(".duration");discount.forEach(function(element){element.textContent="yearly"});if(multipliedPrice.toFixed(2)!="0.00"){var inYearElement=document.getElementById("inYearAmt"+(index+1));inYearElement.innerHTML="Reduced from "+"<span style='text-decoration: line-through;color: red;'>$"+multipliedPrice.toFixed(2)+"</span >/year";inYearElement.style.display="block";inYearElement.style.marginBottom="20px"}})}function ChangeToMonthly(){var Actual=document.querySelectorAll(".whole");Actual.forEach(function(element){element.style.display="block"});var dec=document.querySelectorAll(".cent");dec.forEach(function(element){element.style.display="block"});var discount=document.querySelectorAll(".discounted");discount.forEach(function(element){element.style.display="none"});var discount=document.querySelectorAll(".duration");discount.forEach(function(element){element.textContent="monthly"});var inYear=document.querySelectorAll(".inYear");inYear.forEach(function(element){element.style.display="none"})}async function GetPlans(planId){try{const status=await fetch("/Membership/Default.aspx/PurchaseMembership",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({memberhsipId:planId,duration:duration})});if(status.status===200){var redirect=await status.json();window.location.href=redirect.d}else{}}catch(e){}}async function RenewMembership(planId){try{var Pduration=document.getElementById("duration").value;const status=await fetch("/Membership/Default.aspx/PurchaseMembership",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({memberhsipId:planId,duration:Pduration})});if(status.status===200){var redirect=await status.json();window.location.href=redirect.d}else{}}catch(e){}}async function ActivateDeActivateMembership(planId){var r=confirm("Are you sure you want to downgrade your plan?");if(r==true){try{const status=await fetch("/Membership/Default.aspx/ActivateDeActivateMembership",{method:"POST",headers:{"Content-Type":"application/json",Accept:"application/json"},body:JSON.stringify({PlanId:planId})});if(status.status===200){var redirect=await status.json();if(redirect.d==true){location.reload()}}}catch(e){}}}function upgradeplan(){document.getElementById("maincontainer").style.display="block";document.getElementById("ActivePlan").style.display="none"}
